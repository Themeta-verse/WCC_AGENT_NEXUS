def _default_store_root():
    p=Path(__file__).resolve().parent/'artifacts'/'nexus-living-os-store-path.txt'
    try:
        candidate=p.read_text().strip()
        return candidate if candidate else None
    except Exception:
        return None

def _direct_query_intent(text):
    q=text.lower().strip()
    query_starts=('what should','what matters','what changed','what is blocking',"what's blocking",'requires approval','what can you','what do you know',"what don't you know",'why did','status','next action','attention','stale evidence','what is the health',"what's the health",'what is happening','what did you learn','why are you doing this','what should happen next')
    return q.startswith(query_starts) or q in {'next','what next','why','status','attention','approvals'}

def _natural_language_front_door(argv):
    if not argv or argv[0] in KNOWN_COMMANDS or argv[0].startswith('-'):
        return None
    fp=argparse.ArgumentParser(prog='nexus')
    fp.add_argument('question',nargs='+')
    fp.add_argument('--scope',default='Themeta-verse/Nexus')
    fp.add_argument('--mode',choices=['REAL_READ','SIMULATION','DRY_RUN'],default='REAL_READ')
    fp.add_argument('--browser-url',default='https://github.com/Themeta-verse/Nexus')
    fp.add_argument('--filesystem-path',default='/home/ubuntu/nexus/NEXUS-PERSONAL-OS-PHASE2-REPORT.md')
    fp.add_argument('--repository-scope',default='Themeta-verse/Nexus')
    fp.add_argument('--store-root',default=None)
    s=fp.parse_args(argv); text=' '.join(s.question); store_root=s.store_root or _default_store_root()
    urls=re.findall(r'https?://[^\s]+',text)
    browser_url=urls[0].rstrip('.,);]') if urls else s.browser_url
    governance=governance_for(text)
    if governance.get('state')=='BLOCK':
        return {'front_door':'GOVERNANCE_BLOCK','intent':text,'governance':governance,'execution_allowed':False,'writes_performed':False,'reason':'consequential or destructive intent is unavailable without explicit operation-specific authorization'}
    if text.strip().lower().startswith('continue'):
        recovered=recover(s.scope,store_root); current=outcome(s.scope,store_root); return {'front_door':'CONTINUE','continuation':continuation_intent('continue'),'recovery':recovered,'outcome':current,'next_action':current.get('project_state',{}).get('next_move',{})}
    if _direct_query_intent(text):
        return {'front_door':'COGNITIVE_QUERY','query':text,'result':cognitive_query(text,s.scope,store_root)}
    composer=MissionComposer(); package=composer.compose_capability_mission(text,s.scope,s.mode,browser_url,s.filesystem_path,capabilities=None,store_root=store_root,repository_scope=s.repository_scope); result=composer.execute_capability_mission(package,store_root,s.mode); result['front_door']='SAFE_MISSION_EXECUTION'; result['intent']=text; result['browser_url_selected']=browser_url; return result

