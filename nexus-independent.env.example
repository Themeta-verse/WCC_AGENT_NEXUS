# Copy values into your deployment secret manager or shell; do not commit an .env file.
NEXUS_DATA_ROOT=/var/lib/nexus
NEXUS_DATABASE_URL=sqlite:////var/lib/nexus/nexus.db
NEXUS_WEB_ORIGINS=https://command.example.com
NEXUS_ALLOWED_FILESYSTEM_ROOT=/srv/nexus/evidence
NEXUS_ALLOW_REAL_READS=false
# NEXUS_GITHUB_TOKEN=replace-in-secret-manager
